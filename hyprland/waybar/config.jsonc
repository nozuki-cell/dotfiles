{
    "layer": "top",
    "position": "top",
    "height": 36,
    "spacing": 0,
    "margin-top": 5,
    "margin-left": 10,
    "margin-right": 10,

    "modules-left": [
        "custom/player",
        "custom/cava"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "pulseaudio",
        "network",
        "battery",
        "tray",
        "custom/power"
    ],

    "custom/player": {
        "exec": "playerctl metadata --format '{{ artist }} - {{ title }}' 2>/dev/null",
        "exec-if": "playerctl status 2>/dev/null | grep -qE 'Playing|Paused'",
        "return-type": "text",
        "format": "  {}",
        "max-length": 35,
        "tooltip": true,
        "tooltip-format": "Now Playing:\n{0}",
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next"
    },

    "custom/cava": {
        "exec": "sleep 1 && cava -p /dev/stdin <<EOF
general
framerate 60
bars 8
bar_width 2
bar_spacing 0
bar_height 12
lower_cutoff_freq 50
higher_cutoff_freq 10000
sensitivity 100
source auto
EOF",
        "return-type": "raw",
        "format": "{}",
        "tooltip": false
    },

    "clock": {
        "format": " {:%H:%M}",
        "format-alt": " {:%A, %B %d, %Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "interval": 1,
        "on-click": "gnome-calendar"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " muted",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol",
        "scroll-step": 5,
        "tooltip-format": "Volume: {volume}%\nDevice: {desc}"
    },

    "network": {
        "format-wifi": " {signalStrength}%",
        "format-ethernet": " {ifname}",
        "format-disconnected": " offline",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}\nGateway: {gwaddr}\nDNS: {dns}",
        "on-click": "nm-connection-editor"
    },

    "battery": {
        "states": {
            "full": 100,
            "high": 75,
            "medium": 40,
            "low": 20,
            "critical": 10
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-full": " full",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "Battery: {capacity}%\nTime: {time}"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8,
        "show-passive-items": true
    },

    "custom/power": {
        "format": "⏻",
        "on-click": "wlogout",
        "tooltip": false
    }
}
